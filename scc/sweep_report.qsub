#!/bin/bash -l
#$ -P rise-grid
#$ -N sweep_report
#$ -j y
#$ -pe omp 1
#$ -l h_rt=2:00:00
#
# Held on all six noise evaluations. Writes ONE file that says what happened, so the state of a
# nine-job graph can be read in a single command instead of opening nine logs.
#
# This runs even when upstream jobs FAILED -- `-hold_jid` releases on completion, not success --
# and that is deliberate: a report that only appears on success tells you nothing when something
# breaks. It reports per-model exit status first, and only then the numbers.
set -uo pipefail

repo="${RISE_REPO:-$SGE_O_WORKDIR}"
venv="${RISE_VENV:-$repo/.venv}"

if [ -n "${RISE_MODULES-python3/3.9.9}" ]; then
    module load ${RISE_MODULES:-python3/3.9.9}
fi
source "$venv/bin/activate"
cd "$repo"
export RISE_DATA_ROOT="${RISE_DATA_ROOT:-$repo/all-samples}"
export PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1

out="$repo/docs/NOISE_RESULTS.md"
mkdir -p "$repo/docs"

{
    echo "# Noise sweep — run report"
    echo
    echo "Generated by \`scc/sweep_report.qsub\` on $(date -u +%Y-%m-%dT%H:%M:%SZ)."
    echo "Data root: \`$RISE_DATA_ROOT\`"
    echo
    echo "## Job outcomes"
    echo
    echo "| job | exit | evidence |"
    echo "|---|---|---|"
    for j in noise_generate svm_noise mert_noise cnn_noise crnn_noise ast_noise panns_noise; do
        log="$repo/$j.log"
        if [ ! -f "$log" ]; then
            echo "| $j | **NEVER RAN** | no $j.log |"
            continue
        fi
        marker=$(grep -oE '(RISE_NOISE_EXIT|NOISE_EXIT|RISE_EXIT)=[0-9]+' "$log" | tail -1)
        code="${marker##*=}"
        if [ -z "$marker" ]; then
            if grep -qiE 'traceback|error:|refus' "$log"; then
                echo "| $j | **FAILED** | error in log, no exit marker |"
            else
                echo "| $j | unknown | no exit marker |"
            fi
        elif [ "$code" = "0" ]; then
            echo "| $j | ok | \`$marker\` |"
        else
            echo "| $j | **FAILED ($code)** | \`$marker\` |"
        fi
    done
    echo
    echo "## Clean baselines (regenerated, fingerprint-verified)"
    echo
    python -m instrument_robustness.summarize_results 2>/dev/null | sed -n '/^| model/,/^$/p' \
        || echo "_summarize_results failed; see sweep_report.log_"
    echo
    echo "## Robustness"
    echo
    if python -m instrument_robustness.summarize_results --write >/dev/null 2>&1; then
        echo "\`docs/RESULTS.md\` regenerated. If it shows no noise section, no model produced"
        echo "noise outputs the summariser could verify — check the table above first."
    else
        echo "_summarize_results --write failed._"
    fi
    echo
    echo "## Caveats that survive any result here"
    echo
    echo "- Only CNN and CRNN carry a multi-seed spread. SVM, AST, MERT and PANNs are single"
    echo "  fixed-seed runs, so differences smaller than the CNN/CRNN seed spread are not effects."
    echo "- Two noise realizations per window/type. That is a sensitivity check, not a variance"
    echo "  estimate."
    echo "- Whole-window SNR is the headline. For impulsive noise it averages a short event over"
    echo "  three seconds; read \`snr_segmental_*\` and \`noise_active_fraction\` beside it."
    echo "- Additive digital noise only. No room, microphone, reverberation or channel effects."
} > "$out"

echo "wrote $out"
cat "$out"
echo "SWEEP_REPORT_EXIT=0 $(date)"
