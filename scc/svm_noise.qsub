#!/bin/bash -l

#$ -P rise-grid
#$ -N svm_noise
#$ -j y
#$ -pe omp 4
#$ -l h_rt=12:00:00
#$ -l mem_per_core=8G

set -euo pipefail

noise_repo="${NOISE_REPO:-$SGE_O_WORKDIR}"
noise_data_root="${RISE_DATA_ROOT:?Submit with -v RISE_DATA_ROOT=/projectnb/...}"
# Default to a venv this account can actually write. The old default,
# /projectnb/rise-grid/venvs/$USER/mert, is NOT group-writable -- it is owned by one
# user, and creating it fails with 'Permission denied' for everyone else.
# sklearn only; same venv as the clean SVM run. The venvs are SIBLINGS of the repo, not inside
# it -- `$noise_repo/.venv` has never existed and defaulting to it killed this job on
# 2026-08-03. See scc/activate_venv.sh.
noise_venv="${RISE_VENV:-${NOISE_VENV:-$(dirname "$noise_repo")/venv}}"

# A venv built from the python3 module is NOT self-contained; without this the job dies
# instantly with 'libpython3.9.so.1.0: cannot open shared object file'.
if [ -n "${RISE_MODULES-python3/3.9.9}" ]; then
    module load ${RISE_MODULES:-python3/3.9.9}
fi
. "$noise_repo/scc/activate_venv.sh"
rise_activate "$noise_venv"
cd "$noise_repo"

export PYTHONPATH="$noise_repo/src${PYTHONPATH:+:$PYTHONPATH}"
export RISE_DATA_ROOT="$noise_data_root"
export OMP_NUM_THREADS="${NSLOTS:-4}"
export MKL_NUM_THREADS="${NSLOTS:-4}"
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NUMBA_NUM_THREADS=1
export PYTHONUNBUFFERED=1

test -f "$RISE_DATA_ROOT/work/windows_noisy/noise_manifest.json"
test -f "$RISE_DATA_ROOT/pipeline/norm_stats.npz"
test -f "$noise_repo/artifacts/svm/final_model.joblib"
test -f "$noise_repo/artifacts/svm/test_summary.json"

python -m unittest tests.test_noise tests.test_svm -q
python -m instrument_robustness.noise_sweep --check-generated
python -m instrument_robustness.noise_eval_svm
