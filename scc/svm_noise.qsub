#!/bin/bash -l

#$ -P rise-grid
#$ -N svm_noise
#$ -j y
#$ -pe omp 4
#$ -l h_rt=12:00:00
#$ -l mem_per_core=8G
#
# KEEP THIS JOB OFF THE ivybridge NODES.
#
# noise_eval_svm has now failed four times, every one on a `pi` node -- scc-pi1 three times,
# scc-pi3 once -- and zero times anywhere else. A six-task probe passed on E5-2650 v2,
# E5-2680 v4 and Gold 6132. Two OpenBLAS kernel pins were tried: Haswell turned the SIGSEGV
# into a SIGILL (Ivy Bridge has AVX but no AVX2), SANDYBRIDGE turned it back into a SIGSEGV.
# So the kernel is not the whole story and the fault is NOT root-caused.
#
# Why only SVM is affected: every other evaluation requests `gpus=1`, so the scheduler never
# places it on these nodes. SVM is the only CPU-only job in the sweep, and ivybridge is ~195
# slots, so it keeps landing there.
#
# This is a WORKAROUND. The underlying fault on those nodes is unexplained and worth reporting
# to RCS. broadwell has ~205 slots, so capacity is not a concern.
#$ -l cpu_arch=broadwell

set -euo pipefail

noise_repo="${NOISE_REPO:-$SGE_O_WORKDIR}"
noise_data_root="${RISE_DATA_ROOT:?Submit with -v RISE_DATA_ROOT=/projectnb/...}"
# Default to a venv this account can actually write. The old default,
# /projectnb/rise-grid/venvs/$USER/mert, is NOT group-writable -- it is owned by one
# user, and creating it fails with 'Permission denied' for everyone else.
# sklearn only; same venv as the clean SVM run. The venvs are SIBLINGS of the repo, not inside
# it -- `$noise_repo/.venv` has never existed and defaulting to it killed this job on
# 2026-08-03. See scc/activate_venv.sh.
noise_venv="${RISE_VENV:-${NOISE_VENV:-$(dirname "$noise_repo")/venv}}"

# A venv built from the python3 module is NOT self-contained; without this the job dies
# instantly with 'libpython3.9.so.1.0: cannot open shared object file'.
if [ -n "${RISE_MODULES-python3/3.9.9}" ]; then
    module load ${RISE_MODULES:-python3/3.9.9}
fi
. "$noise_repo/scc/activate_venv.sh"
rise_activate "$noise_venv"
cd "$noise_repo"

export PYTHONPATH="$noise_repo/src${PYTHONPATH:+:$PYTHONPATH}"
export RISE_DATA_ROOT="$noise_data_root"
export OMP_NUM_THREADS="${NSLOTS:-4}"
export MKL_NUM_THREADS="${NSLOTS:-4}"
export OPENBLAS_NUM_THREADS=1

# Force a pre-AVX2 OpenBLAS kernel instead of letting DYNAMIC_ARCH pick one at runtime.
#
# noise_eval_svm has failed twice on the `pi` nodes and nowhere else:
#   2026-08-03  SIGSEGV inside run_noise_evaluation on scc-pi1, reproduced on scc-pi3
#   2026-08-04  SIGILL in the unit tests on scc-pi1, WITH OPENBLAS_CORETYPE=Haswell set
#
# The pi nodes are `hf:cpu_arch=ivybridge` (Xeon E5-2650 v2). Ivy Bridge has AVX but NOT AVX2 --
# AVX2 arrives with Haswell -- so the Haswell pin made it worse: the previous crash was a bad
# runtime kernel choice, and pinning Haswell guaranteed illegal AVX2 instructions instead.
# A six-node probe passed on E5-2650 v2 (login-side), E5-2680 v4 and Gold 6132, which is why
# the shallow probe never reproduced it.
#
# SANDYBRIDGE is the newest kernel Ivy Bridge fully supports (AVX, no AVX2) and is valid on every
# newer node too, so this is correct everywhere rather than a node-specific workaround. The BLAS
# cost is irrelevant here: this evaluation is dominated by reading 60,240 files, not by GEMM.
export OPENBLAS_CORETYPE="${OPENBLAS_CORETYPE:-SANDYBRIDGE}"
export NUMEXPR_NUM_THREADS=1
export NUMBA_NUM_THREADS=1
export PYTHONUNBUFFERED=1

test -f "$RISE_DATA_ROOT/work/windows_noisy/noise_manifest.json"
test -f "$RISE_DATA_ROOT/pipeline/norm_stats.npz"
test -f "$noise_repo/artifacts/svm/final_model.joblib"
test -f "$noise_repo/artifacts/svm/test_summary.json"

python -m unittest tests.test_noise tests.test_svm -q
python -m instrument_robustness.noise_sweep --check-generated
python -m instrument_robustness.noise_eval_svm
