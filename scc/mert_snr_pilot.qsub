#!/bin/bash -l

#$ -P rise-grid
#$ -N mert_snr
#$ -j y
#$ -pe omp 4
#$ -l gpus=1
#$ -l gpu_c=7.0
#$ -l gpu_memory=16G
#$ -l h_rt=06:00:00
#$ -l mem_per_core=8G

set -euo pipefail

pilot_repo="${MERT_REPO:-$SGE_O_WORKDIR}"
pilot_data_root="${RISE_DATA_ROOT:?Submit with -v RISE_DATA_ROOT=/projectnb/...}"
pilot_venv="${MERT_VENV:-/projectnb/rise-grid/venvs/$USER/mert}"
pilot_output_dir="${MERT_OUTPUT_DIR:-$pilot_repo/artifacts/mert}"
pilot_model="${MERT_MODEL_PATH:-$pilot_output_dir/best_probe.pt}"
pilot_report="${MERT_PILOT_OUTPUT:-$pilot_output_dir/snr_pilot.json}"
IFS=':' read -r -a pilot_noise_types <<< "${MERT_PILOT_NOISE:-white}"
pilot_snr_args=()
if [[ -n "${MERT_PILOT_SNRS:-}" ]]; then
    IFS=':' read -r -a pilot_snrs <<< "$MERT_PILOT_SNRS"
    pilot_snr_args=(--snrs "${pilot_snrs[@]}")
fi

source "$pilot_venv/bin/activate"
cd "$pilot_repo"

export PYTHONPATH="$pilot_repo/src${PYTHONPATH:+:$PYTHONPATH}"
export RISE_DATA_ROOT="$pilot_data_root"
export HF_HOME="${HF_HOME:-/projectnb/rise-grid/huggingface/$USER}"
export OMP_NUM_THREADS="${NSLOTS:-4}"
export MKL_NUM_THREADS="${NSLOTS:-4}"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

test -f "$pilot_model"
test -f "$pilot_output_dir/validation_summary.json"

python -c "import torch; print('PyTorch:', torch.__version__); print('GPU:', torch.cuda.get_device_name()); assert torch.cuda.is_available()"
python -m unittest tests.test_noise_adapters -q
python -m instrument_robustness.snr_pilot \
    --model mert \
    --model-path "$pilot_model" \
    --noise "${pilot_noise_types[@]}" \
    "${pilot_snr_args[@]}" \
    --limit "${MERT_PILOT_LIMIT:-240}" \
    --device cuda \
    --output "$pilot_report"
