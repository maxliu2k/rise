#!/bin/bash -l

#$ -P rise-grid
#$ -N mert_ft
#$ -j y
#$ -pe omp 4
#$ -l gpus=1
#$ -l gpu_c=7.0
#$ -l gpu_memory=16G
#$ -l h_rt=8:00:00
#$ -l mem_per_core=8G

# Fine-tune MERT on train, select on validation. Never reads test -- finalization is separate.
#
# Output goes to /project (backed up, 8 GB free), NOT /projectnb (97% of quota). The checkpoint
# is ~380 MB and /projectnb has ~1.2 GB headroom shared with three teammates.

set -euo pipefail

ft_repo="${NOISE_REPO:-$SGE_O_WORKDIR}"
ft_venv="${RISE_VENV:-${NOISE_VENV:-$(dirname "$ft_repo")/venv_mert}}"
ft_out="${RISE_FT_OUT:-/project/rise-grid/$USER/mert_ft}"
# all-samples lives OUTSIDE the repo on this cluster, and config.DATA_ROOT silently falls back
# to <repo>/all-samples when this is unset -- which resolves, then reports all 5,861 windows
# missing after the model has already loaded. Demand it up front.
ft_data_root="${RISE_DATA_ROOT:?Submit with -v RISE_DATA_ROOT=/projectnb/rise-grid/\$USER/all-samples}"

if [ -n "${RISE_MODULES-python3/3.9.9}" ]; then
    module load ${RISE_MODULES:-python3/3.9.9}
fi
. "$ft_repo/scc/activate_venv.sh"
rise_activate "$ft_venv"
cd "$ft_repo"
export RISE_DATA_ROOT="$ft_data_root"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1 || true
echo "data root : $RISE_DATA_ROOT"
echo "output dir: $ft_out"
echo

# CHEAP CHECKS FIRST. The previous ordering loaded a 95M backbone and ran the gradient probe
# before touching the filesystem, so a missing data root cost a GPU minute to discover.
test -f "$RISE_DATA_ROOT/pipeline/windows.csv" \
    || { echo "FATAL: no windows.csv under $RISE_DATA_ROOT/pipeline" >&2; exit 1; }
test -d "$RISE_DATA_ROOT/work/windows" \
    || { echo "FATAL: no work/windows under $RISE_DATA_ROOT" >&2; exit 1; }

# Then the expensive one: can this environment backprop through MERT at all?
python scc/mert_ft_smoke.py --batches "${RISE_FT_BATCH:-16}"

python -m instrument_robustness.train_mert_ft \
    --output-dir "$ft_out" \
    --batch-size "${RISE_FT_BATCH:-16}" \
    --backbone-lr "${RISE_FT_BACKBONE_LR:-1e-5}" \
    --head-lr "${RISE_FT_HEAD_LR:-1e-3}" \
    --max-epochs "${RISE_FT_EPOCHS:-12}" \
    --patience "${RISE_FT_PATIENCE:-3}" \
    --seed "${RISE_FT_SEED:-42}"
