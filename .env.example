# Copy to .env and adjust as needed.

# Where the audio + pipeline artifacts live (manifest.csv, work/, features/, pipeline/).
# Defaults to <repo>/all-samples if unset. Point this at the shared cluster dataset root.
# RISE_DATA_ROOT=/Users/gavin/Music Project/Real Project/rise/all-samples

# Optional comma-separated class set used when rebuilding preprocessing artifacts.
# AST training discovers the active classes directly from pipeline/windows.csv.
# TinySOL 12-class:
# RISE_TARGET_LABELS=violin,viola,cello,double bass,flute,clarinet,oboe,bassoon,trumpet,french horn,trombone,tuba
