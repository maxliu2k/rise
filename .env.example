# Copy to .env and adjust as needed.

# ---- Active data root for the pipeline steps ----
# Which dataset the step scripts read/write. Defaults to Philharmonia (all-samples).
# Point this at the shared cluster dataset root when training remotely.
# RISE_DATA_ROOT=/path/to/data-root

# ---- Per-dataset roots ----
# Each has pipeline/ metadata in git; work/, features/, and checkpoints/ remain external.
# Philharmonia (9-class). Defaults to <repo>/all-samples.
# RISE_PHIL_ROOT=/path/to/all-samples
# TinySOL (12-class, lossless WAV). Defaults to <repo>/tinysol.
# RISE_TINYSOL_ROOT=/path/to/tinysol

# ---- Class set (comma-separated) ----
# Defaults to the 9 Philharmonia labels. For TinySOL use the 12 (config.TINYSOL_LABELS):
# RISE_TARGET_LABELS=violin,viola,cello,double bass,flute,clarinet,oboe,bassoon,trumpet,french horn,trombone,tuba

# AST discovers labels directly from pipeline/windows.csv. Set both variables only when rebuilding
# TinySOL preprocessing artifacts:
#   RISE_DATA_ROOT="$RISE_TINYSOL_ROOT" \
#   RISE_TARGET_LABELS="violin,viola,cello,double bass,flute,clarinet,oboe,bassoon,trumpet,french horn,trombone,tuba" \
#   python -m instrument_robustness.step0_filter
